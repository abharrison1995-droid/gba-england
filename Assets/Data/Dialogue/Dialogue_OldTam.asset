  StartingNode:
    Speaker: {fileID: 11400000, guid: 3b7d091fd2233ba498cc698ac7346781, type: 2}
    DialogueText: "Spare a coin for Old Tam? No? Then spare an ear \u2014 I hear
      things, sat here by the gates."
    Choices:
    - ChoiceText: What have you heard?
      NextNode:
        Speaker: {fileID: 11400000, guid: 3b7d091fd2233ba498cc698ac7346781, type: 2}
        DialogueText: Bandits been creeping back into the old manor west of here.
          Someone's paying them, mark me. Nobody squats in a ruin for free.
        Choices: []
