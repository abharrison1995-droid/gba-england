  StartingNode:
    Speaker: {fileID: 11400000, guid: abbd044c9ab768148ade660d4d4c5bf8, type: 2}
    DialogueText: Hold there, exile. London's gates don't open for cellar-rats. State
      your business.
    Choices:
    - ChoiceText: I fought my way out of the Manor Cellars. I've earned passage.
      NextNode:
        Speaker: {fileID: 11400000, guid: abbd044c9ab768148ade660d4d4c5bf8, type: 2}
        DialogueText: The cellars, eh? Then you're tougher than you look. Keep your
          blade sheathed inside the walls and we'll have no quarrel.
        Choices: []
      RequiredStat: 
      RequiredStatLevel: 0
      GrantQuestId: 
      GrantQuestTitle: 
      GrantQuestObjective: 
      GrantQuestLocation: 
      TeachSpark: 0
      CompleteQuestId: 
    - ChoiceText: '[Shove past him]'
      NextNode:
        Speaker: {fileID: 11400000, guid: abbd044c9ab768148ade660d4d4c5bf8, type: 2}
        DialogueText: "Oof\u2014 all right, all right! No need for that. Go on through,
          brute."
        Choices: []
      RequiredStat: STR
      RequiredStatLevel: 4
      GrantQuestId: 
      GrantQuestTitle: 
      GrantQuestObjective: 
      GrantQuestLocation: 
      TeachSpark: 0
      CompleteQuestId: 
    - ChoiceText: Never mind.
