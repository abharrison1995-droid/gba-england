  - Id: mf_return
    Speaker: {fileID: 11400000, guid: a3b9ec1b7a1940328ccc4dc9751d19fd, type: 2}
    DialogueText: Arr, very nice there, lad. I knew you'd come back for me. Here's
      a little thing for you.
    Choices:
    - ChoiceText: Great, cheers.
      NextNodeId: mf_eastyork
      QuestGate: 0
      QuestGateId: 
      QuestGateStage: 0
      RequiredStat: 
      RequiredStatLevel: 0
      RequiredItem: {fileID: 0}
      RequiredItemQuantity: 1
      ConsumeRequiredItem: 0
      GrantQuestId: 
      GrantQuestTitle: 
      GrantQuestObjective: 
      GrantQuestLocation: 
      TeachSpark: 0
      CompleteQuestId: 
