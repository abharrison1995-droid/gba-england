  - Id: mf_price
    Speaker: {fileID: 11400000, guid: a3b9ec1b7a1940328ccc4dc9751d19fd, type: 2}
    DialogueText: Ten bus barnacles, and I can help you.
    Choices:
    - ChoiceText: Brilliant. Bus barnacles again. Okay, I'll be back.
      NextNodeId: 
      QuestGate: 0
      QuestGateId: 
      QuestGateStage: 0
