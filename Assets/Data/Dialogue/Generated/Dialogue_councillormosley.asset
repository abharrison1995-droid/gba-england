      HireCompanionFree: 0
      CompanionCommand: 0
    - ChoiceText: About that vape situation in the basement...
      NextNodeId: nag_one
      QuestGate: 2
      QuestGateId: mosley_vape_quest_one
      QuestGateStage: 0
      RequiredStat: 
