      MerchantAction: 0
      HireCompanionId: 
      HireCompanionFree: 0
      CompanionCommand: 0
  - Id: end_accept
    Speaker: {fileID: 11400000, guid: 3d22b009a9dc50a2679df5e6754db9d3, type: 2}
    DialogueText: Splendid! I've marked the cellar details in your journal. I'll
      be right here waiting. Chop chop, old boy!
    Choices: []
  - Id: end_decline
    Speaker: {fileID: 11400000, guid: 3d22b009a9dc50a2679df5e6754db9d3, type: 2}
    DialogueText: Agh! I'll be right here weeping if you change your mind!
    Choices: []
  - Id: nag_one
    Speaker: {fileID: 11400000, guid: 3d22b009a9dc50a2679df5e6754db9d3, type: 2}
    DialogueText: COME ON CHAP! GET ME THAT VAPE AND DO NOT TAKE A PUFF ON IT!
    Choices:
    - ChoiceText: Keep your hair on, I'm working on it.
      NextNodeId: nag_two
      QuestGate: 0
      QuestGateId: 
      QuestGateStage: 0
      RequiredStat: 
      RequiredStatLevel: 0
      RequiredItem: {fileID: 0}
      RequiredItemQuantity: 1
      ConsumeRequiredItem: 0
      GrantQuestId: 
      GrantQuestTitle: 
      GrantQuestObjective: 
      GrantQuestLocation: 
      TeachSpark: 0
      CompleteQuestId: 
      Merchant: {fileID: 0}
      MerchantAction: 0
      HireCompanionId: 
      HireCompanionFree: 0
      CompanionCommand: 0
  - Id: nag_two
    Speaker: {fileID: 11400000, guid: 3d22b009a9dc50a2679df5e6754db9d3, type: 2}
    DialogueText: WHAT ARE YOU WAITING FOR?! I CAN PRACTICALLY HEAR THEM HUFFING
      IT FROM HERE!
    Choices:
    - ChoiceText: Here's your vape. What did you put in this, chemical weapons?
      NextNodeId: vape_returned
      QuestGate: 0
      QuestGateId: 
      QuestGateStage: 0
      RequiredStat: 
      RequiredStatLevel: 0
      RequiredItem: {fileID: 11400000, guid: 25ecbf4426e79c7a75bc0b81f832f7ae, type: 2}
      RequiredItemQuantity: 1
      ConsumeRequiredItem: 1
      GrantQuestId: daniel_pauls_quest_one
      GrantQuestTitle: 
      GrantQuestObjective: 
      GrantQuestLocation: 
      TeachSpark: 0
      CompleteQuestId: mosley_vape_quest_one
      Merchant: {fileID: 0}
      MerchantAction: 0
      HireCompanionId: 
      HireCompanionFree: 0
      CompanionCommand: 0
    - ChoiceText: Just give me a bit more time.
      NextNodeId: 
      QuestGate: 0
      QuestGateId: 
      QuestGateStage: 0
      RequiredStat: 
      RequiredStatLevel: 0
      RequiredItem: {fileID: 0}
      RequiredItemQuantity: 1
      ConsumeRequiredItem: 0
      GrantQuestId: 
      GrantQuestTitle: 
      GrantQuestObjective: 
      GrantQuestLocation: 
      TeachSpark: 0
      CompleteQuestId: 
      Merchant: {fileID: 0}
      MerchantAction: 0
      HireCompanionId: 
      HireCompanionFree: 0
      CompanionCommand: 0
  - Id: vape_returned
    Speaker: {fileID: 11400000, guid: 3d22b009a9dc50a2679df5e6754db9d3, type: 2}
    DialogueText: "Good man! Splendid work. Now, you should get back over to Daniel
      Pauls \u2014 I hear he's in a spot of bother near the church."
    Choices:
    - ChoiceText: On my way.
      NextNodeId: 
      QuestGate: 0
      QuestGateId: 
      QuestGateStage: 0
      RequiredStat: 
      RequiredStatLevel: 0
      RequiredItem: {fileID: 0}
      RequiredItemQuantity: 1
      ConsumeRequiredItem: 0
      GrantQuestId: 
      GrantQuestTitle: 
      GrantQuestObjective: 
      GrantQuestLocation: 
      TeachSpark: 0
      CompleteQuestId: 
